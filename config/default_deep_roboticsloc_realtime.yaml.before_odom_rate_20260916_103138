# =====================================================================
# 实时定位配置文件（低性能处理器 / 机器狗机载电脑）
# 基于 default_deep_roboticsloc.yaml（在线定位）改造。
# 目标：在 RK3588 等低算力平台上，配合已建好的地图实现实时定位。
# 策略：
#   - LIO 前端降低点云密度/迭代/邻近搜索，保证里程计实时输出；
#   - 全局 NDT 定位仅关键帧执行 + 隔帧执行，降低地图匹配占用；
#   - NDT 网格加粗、迭代减少；关闭 UI/RViz/回环。
# 使用前请确认 system.map_path 指向已建好的地图目录
# （默认指向实时建图配置的输出 ./data/map_realtime/）。
# =====================================================================

common:
  lidar_topic: "/LIDAR/POINTS"
  livox_lidar_topic: "/livox/lidar" # 不使用，也要有，否则会报错
  imu_topic: "/IMU"

# fasterlio 参数
fasterlio:
  lidar_type: 4                # 1 for Livox serials LiDAR, 2 for Velodyne LiDAR, 3 for ouster LiDAR,  4 or RoboSense LiDAR
  scan_line: 32
  blind: 0.5                # 盲区，小于盲区距离的不会处理
  time_scale: 1e-3             # 兼容不同数据集的时间单位，仅对Velodyne LiDAR(lidar_type=2)生效

  skip_lidar_num: 4 # 点云跳帧。1=隔帧LIO（中间帧位姿由IMU递推），减半计算量保证实时；定位精度略有下降
  max_lidar_buffer_size: 32 # 计算跟不上时尽早丢旧帧，降低滞后感
  max_imu_buffer_size: 4000
  imu_buffer_duration: 5.0
  imu_buffer_guard_time: 0.2
  robosense_rebatch: true
  robosense_scan_period: 0.1
  robosense_rebatch_delay: 0.3
  robosense_publish_time_threshold: 0.05
  robosense_mode_probe_frames: 5
  robosense_min_bin_points: 100
  point_filter_num: 32 # 点云采样（越大参与计算的点越少）。低功耗=16
  max_iteration: 2 # IEKF 最大迭代次数。低功耗=2
  # 0.5 m 会触发"点数少于原始点10%时退回0.1 m"的保护逻辑，反而显著变慢。
  filter_size_scan: 0.8 # 当前帧体素降采样。低功耗=0.8
  filter_size_map: 0.8 # LIO 局部地图体素分辨率，同上

  ivox_grid_resolution: 0.8
  ivox_nearby_type: 6 # 邻近栅格 6/18/26。6=仅面邻域，检索代价最低
  esti_plane_threshold: 0.1        # default=0.1

  use_aa: false  # use anderson-acceleration

  acc_cov: 0.1
  gyr_cov: 0.1
  b_acc_cov: 0.0001
  b_gyr_cov: 0.0001
  extrinsic_est_en: false      # true: enable the online estimation of IMU-LiDAR extrinsic
  extrinsic_T: [ 0, 0, 0 ]
  extrinsic_R: [ 1, 0, 0,
                 0, 1, 0,
                 0, 0, 1 ]
  keep_first_imu_estimation: false

g2p5:
  esti_floor: false   # 是否动态估计地面
  lidar_height: 0.0   # 雷达安装高度
  floor_height: -1.2   # 默认地面高度
  min_th_floor: 0.50  # 距离地面这个高度的障碍物被扫入栅格地图中
  max_th_floor: 1.0  # 距离地面这个高度的障碍物被扫入栅格地图中
  grid_map_resolution: 0.2 # 栅格地图分辨率

system:
  with_loop_closing: false # 定位模式不使用回环，关闭以节省CPU
  with_ui: false # 机载端关闭 Pangolin 3D UI（RK3588 无显示且 EGL 初始化会崩溃）
  with_2dui: false # 是否需要2D UI
  with_g2p5: false # 是否需要栅格地图
  step_on_kf: false # 是否在关键帧处暂停
  log_pose_opt: false # 命令行打印位置和速度
  pub_odom: true
  enable_lidar_loc_skip: true # 允许跳过部分关键帧的全局NDT，节省CPU
  enable_lidar_loc_rviz: true # 发布 /lightning/current_scan_cloud 与 /lightning/global_map，RViz 才能看到加载的地图
  enable_path_rviz: true # 发布 /lightning/path 定位轨迹
  enable_lidar_odom_skip: false # 里程计需满帧输出，不建议开启
  evaluation: false
  lidar_loc_skip_num: 8 # 每 4 个关键帧执行一次全局NDT（NDT占用降至 1/4）
  lidar_odom_skip_num: 2
  map_path: /var/opt/robot/data/lightning/data/map_offline/ # 离线高精度建图输出的地图目录
  use_init_pose: false
  # 初始位置 [x, y, z]
  init_pos: [0.0, 0.0, 0.0]
  # 初始四元数 [x, y, z, w]
  init_quat: [0.0, 0.0, 0.0, 1.0]
  pub_tf: true

loop_closing:
  loop_kf_gap: 10       # 每隔多少个关键帧检查一次
  min_id_interval: 20   # 被检查的关键帧ID间隔
  closest_id_th: 20     # 历史关键帧与当前帧的ID间隔
  max_range: 60.0       # 候选帧的最大距离
  ndt_score_th: 2.0     # ndt位姿分值
  with_height: true

### localization ================================================================================================
lidar_loc:
  enable_dynamic_polygon: false
  enable_parking_static: true
  enable_icp_adjust: false
  filter_intensity_max: 100.0
  filter_intensity_min: 10.0
  filter_z_max: 30.0
  filter_z_min: -1.0
  force_2d: false
  grid_search_angle_range: 180.0
  grid_search_angle_step: 18
  lidar_loc_odom_th: 0.5
  init_with_fp: true
  min_init_confidence: 1.8
  min_tracking_confidence: 1.0
  ndt_num_threads: 4 # 与机载端可用核心数匹配（RK3588 常用 4 核）
  ndt_max_iterations: 2 # NDT 最大迭代，低功耗=2
  ndt_resolution: 2.0 # NDT 网格分辨率，低功耗=2.0（越粗栅格越少、匹配越快，精度略降）
  update_dynamic_cloud: false
  update_err_h: 0.2
  update_err_v: 0.2
  update_kf_dis: 2.0
  update_lidar_loc_score: 2.5
  # 只在 LIO 关键帧上执行全局 NDT，避免地图匹配抢占 LIO 实时计算资源。
  loc_on_kf: true
  # 异步执行 NDT，避免地图匹配阻塞 LIO 里程计，保证实时输出（map->odom 校正略有延迟）。
  async_lidar_loc: true
  # NDT 估计 map->odom，LIO 输出 odom->lidar；小增益抑制单帧 NDT 抖动。
  map_odom_correction_gain: 0.02
  map_odom_max_translation_jump: 0.5
  map_odom_max_rotation_jump_deg: 15.0
  try_self_extrap: false

maps:
  delete_when_unload: false
  dyn_cloud_policy: short
  load_dyn_cloud: false
  load_map_size: 2
  max_pts_dyn_chunk: 100000
  save_dyn_when_quit: false
  save_dyn_when_unload: false
  unload_map_size: 4
  with_dyn_area: false

# fuse LIO, LiDAR localization( requires a pre-built map), Dead Reckoning, RTK
pgo:
  # Trust DR more during severe motion (decrease noise values)
  dr_pos_noise: 2.0         # Reduce from 1.0
  dr_ang_noise: 0.7         # Reduce from 0.5
  # Trust LIO and lidar_loc less (increase noise values)
  lidar_odom_pos_noise: 0.3  # Increase from 0.3
  lidar_odom_ang_noise: 1.0  # Increase from 1.0
  lidar_loc_pos_noise: 0.4   # Increase from 0.3
  lidar_loc_ang_noise: 0.3   # Increase from 1.0
  # More lenient outlier rejection
  lidar_loc_outlier_th: 10.0 # Increase from 5.0
  # Relax convergence criteria for dynamic motion
  pgo_frame_converge_pos_th: 0.1   # Increase from 0.05
  pgo_frame_converge_ang_th: 2.0   # Increase from 1.0
  rtk_fix_ang_noise: 2.0
  rtk_fix_pos_noise: 1.0
  rtk_height_noise_ratio: 10.0
  rtk_other_ang_noise: 10.0
  rtk_other_pos_noise: 5.0
  rtk_outlier_th: 1.0
  smooth_factor: 0.01

roi:
  # 定位模式 ROI 已较紧，进一步收窄到 15m，压缩点云数量
  height_max: 2.0
  height_min: -1.0
  range_max: 15
  range_min: 0.5

ui:
  car_length: 2.0
  car_width: 1.6
  car_height: 1.7
  scans: 1
